DB_NAME=cs361_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

DB_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Local seeded accounts only. Development auth is rejected in production/Lambda.
AUTH_MODE=development
DEV_AUTH_PASSWORD=V3-local-only!
DEV_AUTH_SECRET=cs361-development-only-change-before-sharing
# Application-Key ของ TU API: นักศึกษาสาขาวิทยาการคอมพิวเตอร์ login ด้วยเลขทะเบียน@dome.tu.ac.th + รหัส TU
TU_API_KEY=
# Production: cognito (direct verifier) or api-gateway (verified Lambda authorizer claims).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

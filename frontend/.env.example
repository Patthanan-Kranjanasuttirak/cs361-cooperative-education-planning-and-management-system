# Backend URL รวม /api ไม่ต้องมี / ปิดท้าย
# เปลี่ยนพอร์ตให้ตรง BACKEND_PORT ของ root .env
VITE_API_URL=http://localhost:5000/api

# การเข้าสู่ระบบ: development (บัญชีทดสอบใน DB) หรือ cognito (TU API + Google ผ่าน Amplify)
# ดูวิธีตั้งค่า AWS ที่ backend/cognito-triggers/README.md
VITE_AUTH_MODE=development
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Cognito domain ไม่ต้องมี https:// เช่น cs361-coop.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
